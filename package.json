{
  "name": "smart-urban-green-management-system",
  "version": "1.0.0",
  "description": "Smart Urban Green Management System - MERN Stack",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "start": "node server/server.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm --prefix server install && npm --prefix client install",
    "seed": "node server/seed.js",
    "seed:users": "node server/utils/seedUsers.js"
  },
  "keywords": [
    "mern",
    "urban-green",
    "iot",
    "gis",
    "react",
    "express",
    "mongodb",
    "vercel"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^11.2.0"
  }
}
